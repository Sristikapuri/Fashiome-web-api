# Copy this file to `playwright.env` (gitignored) and adjust as needed.
# The frontend (npm run dev), backend (npm run dev in Fashiome_Backend) and
# MongoDB must already be running before you run the E2E suite.

E2E_BASE_URL=http://localhost:3000
E2E_API_BASE_URL=http://localhost:8089

# Seeded via `npm run create-admin` in Fashiome_Backend.
ADMIN_EMAIL=admin@fashiome.com
ADMIN_PASSWORD=admin123

# MailHog is used to verify the forgot/reset password email flow end-to-end.
# Run it locally with: docker run -d --name mailhog -p 1025:1025 -p 8025:8025 mailhog/mailhog
# Then point the backend's .env at it:
#   EMAIL_HOST=localhost
#   EMAIL_PORT=1025
#   EMAIL_USER=test@fashiome.local
#   EMAIL_PASSWORD=anything
MAILHOG_API_URL=http://localhost:8025
